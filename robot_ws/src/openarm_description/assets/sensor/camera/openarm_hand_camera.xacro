<!--
  Gazebo 专用的手眼相机（只用于 sim:=gz，不进入真机 robot_description）。

  为什么不用 assets/sensor/zed：那套依赖 zed_description（本机未安装），而且是
  双目大相机，不适合装在夹爪上。这里用原生 SDF camera sensor，零额外依赖。

  gz camera sensor 的光轴沿 link 的 +X 方向。v1.0 的 openarm_right_hand 的
  +Z 才是"朝外/手指伸出方向"，所以默认 rpy="0 -1.5708 0" 把光轴转过去。
  画面方向不对时改 rpy 即可。
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:macro name="openarm_hand_camera"
               params="parent_link
                       camera_name:='hand_camera'
                       xyz:='0 0 0.06'
                       rpy:='0 -1.5708 0'
                       width:=640
                       height:=480
                       hfov:=1.2
                       update_rate:=15
                       topic:='/hand_camera/image'">

    <link name="${camera_name}_link">
      <inertial>
        <mass value="0.01"/>
        <inertia ixx="1e-6" ixy="0" ixz="0" iyy="1e-6" iyz="0" izz="1e-6"/>
      </inertial>
      <visual>
        <geometry>
          <box size="0.02 0.02 0.02"/>
        </geometry>
        <material name="dark_grey">
          <color rgba="0.1 0.1 0.1 1.0"/>
        </material>
      </visual>
      <collision>
        <geometry>
          <box size="0.02 0.02 0.02"/>
        </geometry>
      </collision>
    </link>

    <joint name="${camera_name}_joint" type="fixed">
      <parent link="${parent_link}"/>
      <child link="${camera_name}_link"/>
      <origin xyz="${xyz}" rpy="${rpy}"/>
    </joint>

    <!-- URDF 转 SDF 时，这个 <gazebo reference> 会被搬进对应 link 的 <sensor> -->
    <gazebo reference="${camera_name}_link">
      <sensor name="${camera_name}" type="camera">
        <!-- 固定 gz 话题名，方便 ros_gz_bridge 直接桥接 -->
        <topic>${topic}</topic>
        <update_rate>${update_rate}</update_rate>
        <always_on>true</always_on>
        <visualize>true</visualize>
        <camera>
          <horizontal_fov>${hfov}</horizontal_fov>
          <image>
            <width>${width}</width>
            <height>${height}</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>0.01</near>
            <far>10.0</far>
          </clip>
          <noise>
            <type>gaussian</type>
            <mean>0.0</mean>
            <stddev>0.007</stddev>
          </noise>
        </camera>
      </sensor>
    </gazebo>
  </xacro:macro>

</robot>
